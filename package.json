{
  "name": "bourse-collector",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "worker": "tsx src/worker/index.ts",
    "worker:start": "node dist-worker/worker/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "workflow:quick": "tsx --env-file=.env scripts/quick-workflow.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "6.19.1",
    "bullmq": "6.7.8",
    "crawlee": "3.18.2",
    "cheerio": "1.1.2",
    "csv-parse": "7.0.3",
    "fast-xml-parser": "5.12.1",
    "ioredis": "5.8.2",
    "ipaddr.js": "2.2.0",
    "next": "16.4.6",
    "pino": "10.1.0",
    "pdf-parse": "2.4.5",
    "playwright": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "robots-parser": "3.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "prisma": "6.19.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
