# Docker Compose provides these automatically. Only set them for non-Docker development.
DATABASE_URL=postgresql://bourse:bourse@localhost:5432/bourse?schema=public
REDIS_URL=redis://localhost:6379

# Public hostname used by Caddy in Docker. Compose defaults to localhost for local use.
# Production deployment configures this as pbxlab.online.
APP_DOMAIN=localhost
APP_PORT=3000

# Required for the administrator dashboard. Never commit real values.
# ADMIN_PASSWORD_HASH format: scrypt$32768$8$1$<base64url-salt>$<base64url-digest>
# AUTH_SESSION_SECRET must be a cryptographically random value of at least 32 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
AUTH_SESSION_SECRET=
# Optional; defaults to 12 hours and accepts 5 minutes through 7 days.
AUTH_SESSION_TTL_SECONDS=43200

SERPAPI_KEY_PRIMARY=
SERPAPI_KEY_SECONDARY=
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=
AGENTROUTER_MODEL=openai/gpt-5.6-sol

CRAWLER_MAX_DEPTH=4
CRAWLER_DEFAULT_DOMAIN_PAGE_LIMIT=100
CRAWLER_GLOBAL_CONCURRENCY=5
CRAWLER_PER_DOMAIN_CONCURRENCY=2
CRAWLER_REQUEST_TIMEOUT_MS=30000
CRAWLER_MAX_CONTENT_BYTES=5242880
CRAWLER_MAX_CHILD_URLS=20
CRAWLER_BROWSER_ENABLED=true
AI_MONTHLY_BUDGET_USD=30
SERPAPI_MONTHLY_BUDGET=6000

# Durable worker schedules. Defaults run dork discovery at 07:00 and 19:00,
# then watch all enabled sources every Sunday at 03:00.
DISCOVERY_DORK_CRON=0 7,19 * * *
SOURCE_WATCH_CRON=0 3 * * 0
AUTOMATION_TIMEZONE=Africa/Lagos
DISCOVERY_DORKS_PER_RUN=6
DISCOVERY_GLOBAL_DORKS_PER_RUN=4
DISCOVERY_RESULTS_PER_QUERY=30
TELEGRAM_DISCOVERY_COOLDOWN_SECONDS=300

# Create a bot with @BotFather, then add it to the destination chat/channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Recommended for inbound commands on a public HTTPS deployment. Generate a
# random URL-safe value with at least 32 characters and register the webhook.
TELEGRAM_WEBHOOK_SECRET=
# Optional topic ID for a Telegram forum chat.
TELEGRAM_MESSAGE_THREAD_ID=
